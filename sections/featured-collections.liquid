{% style %}
.akco-featured-collections {
  --akco-collections-ink: #1a1a1a;
  --akco-collections-muted: #65675d;
  --akco-collections-gold: #8b6220;
  --akco-collections-serif: Georgia, serif;
  --featured-card-width: min(400px, 40cqw);
  --collections-background: #f6f3ee;
  container-type: inline-size;
  background: var(--collections-background);
  color: var(--akco-collections-ink);
  font: 1rem/1.55 Arial, sans-serif;
}
.akco-featured-collections, .akco-featured-collections * { box-sizing: border-box; }
.akco-featured-collections a { text-decoration: none; }
.akco-collections-shop:focus-visible {
  outline: 2px solid var(--akco-collections-gold);
  outline-offset: 3px;
}
.akco-collections-empty { align-self: center; padding: 20px; }
@media (max-width: 760px) {
  .akco-featured-collections { --featured-card-width: min(400px, 82cqw); }
}

.akco-collections-layout {
  --collections-column-gap: clamp(24px, 4vw, 68px);
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
  align-items: center;
  gap: var(--collections-column-gap);
  padding-block: clamp(32px, 6svh, 64px) clamp(20px, 4svh, 48px);
}
.akco-collections-intro { padding-inline-start: clamp(20px, 3.5vw, 64px); }
.akco-collections-intro h2 {
  margin: 0;
  color: inherit;
  font-family: inherit;
  font-size: clamp(28px, 4.4vw, 76px);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -.045em;
  text-transform: uppercase;
}
.akco-collections-intro p { max-width: 34ch; color: var(--akco-collections-muted); }
.akco-collections-shop {
  display: inline-block;
  padding: 14px 22px;
  border-radius: 999px;
  background: var(--akco-collections-ink);
  color: white;
}
.akco-collections-rail {
  position: relative;
  overflow-x: auto;
  scroll-behavior: auto;
  overscroll-behavior-x: contain;
  padding-bottom: 8px;
  scrollbar-width: none;
}
.akco-collections-rail::-webkit-scrollbar { display: none; }
.akco-collections-cards {
  display: flex;
  inline-size: max-content;
  gap: 16px;
  background: var(--collections-background);
}
.akco-collections-card {
  position: relative;
  display: grid;
  align-items: end;
  flex: 0 0 var(--featured-card-width);
  min-width: 0;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  border-radius: 22px;
  background: #26353f;
  color: white;
}
.akco-collections-product {
  position: absolute;
  inset: 0;
}
.akco-collections-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.akco-collections-details {
  position: relative;
  display: grid;
  gap: 8px;
  padding: 28px clamp(12px, 1.6vw, 20px) clamp(12px, 1.6vw, 20px);
  background: linear-gradient(transparent, rgb(9 12 17 / 94%) 80%);
  pointer-events: none;
}
.akco-collections-name { font: 400 clamp(1.125rem, 2.8vw, 2.25rem)/1.1 var(--akco-collections-serif); }
.akco-collections-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin: 0;
}
.akco-collections-price { font-weight: 600; }
.akco-collections-cart-form { margin: 0; margin-inline-start: auto; }
.akco-collections-add {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 44px;
  margin-inline-start: auto;
  padding: 8px 14px;
  border: 1px solid rgb(255 255 255 / 75%);
  border-radius: 999px;
  background: linear-gradient(155deg, white, #f6ebe0);
  color: #1a1a1a;
  font: 600 .75rem/1.2 Arial, sans-serif;
  letter-spacing: .03em;
  white-space: nowrap;
  box-shadow: inset 0 1px 4px white, 0 3px 10px rgb(0 0 0 / 25%);
  cursor: pointer;
  pointer-events: auto;
}
.akco-collections-add:disabled { opacity: .7; cursor: default; }
.akco-collections-add:hover:enabled, a.akco-collections-add:hover { background: white; }
.akco-collections-bag-icon {
  position: relative;
  flex: 0 0 14px;
  height: 13px;
  margin-top: 3px;
  border: 1.5px solid currentColor;
  border-radius: 3px;
}
.akco-collections-bag-icon::before {
  content: "";
  position: absolute;
  inset: -5px 3px auto;
  height: 6px;
  border: 1.5px solid currentColor;
  border-bottom: 0;
  border-radius: 5px 5px 0 0;
}
.akco-collections-wishlist {
  position: absolute;
  inset-block-start: 12px;
  inset-inline-end: 12px;
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  padding: 0;
  border-radius: 50%;
  cursor: pointer;
  border: 1px solid rgb(255 255 255 / 30%);
  background: linear-gradient(145deg, rgb(255 255 255 / 12%), rgb(6 12 17 / 24%));
  background-clip: padding-box;
  color: #f5f4f0;
  -webkit-backdrop-filter: blur(5px);
  backdrop-filter: blur(5px);
}
.akco-collections-wishlist:hover { border-color: rgb(255 255 255 / 70%); }
.akco-collections-wishlist[hidden] { display: none; }
.akco-collections-wishlist[aria-pressed="true"] { background: var(--akco-collections-ink); color: white; }
.akco-collections-wishlist svg {
  width: 16px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
  filter: drop-shadow(0 1px 2px rgb(3 18 6 / 80%));
}
.akco-collections-wishlist[aria-pressed="true"] svg { fill: currentColor; }
.akco-collections-rail:focus-visible, .akco-collections-product:focus-visible,
.akco-collections-add:focus-visible, .akco-collections-wishlist:focus-visible {
  outline: 2px solid var(--akco-collections-gold);
  outline-offset: -3px;
}
@media (width > 760px) {
  .akco-collections-intro { grid-area: 1 / 1; }
  .akco-collections-shop:focus-visible { position: relative; z-index: 1; }
  .akco-collections-rail {
    grid-area: 1 / 1 / 2 / -1;
    /* Start in the second column, then let the cards scroll over the title. */
    padding-inline-start: calc((100% - var(--collections-column-gap)) * .4 + var(--collections-column-gap));
    pointer-events: none;
  }
  .akco-collections-cards { pointer-events: auto; }
}
@media (width > 760px) and (prefers-reduced-motion: no-preference) {
  .akco-collections-intro > :not(:focus-visible) { filter: blur(var(--collections-blur, 0px)); }
}
@media (max-width: 760px) {
  .akco-collections-layout { grid-template-columns: minmax(0, 1fr); gap: 18px; }
  .akco-collections-intro, .akco-collections-rail { padding-inline: 20px; }
}
{% endstyle %}

{%- liquid
  assign featured_collection = section.settings.collection
  assign featured_products = section.settings.products
  if featured_products == blank and featured_collection != blank
    assign featured_products = featured_collection.products
  endif
  assign button_url = section.settings.button_url | default: featured_collection.url | default: routes.all_products_collection_url
-%}

{% if featured_products != blank or request.design_mode %}
  <section class="akco-featured-collections" aria-labelledby="AkcoCollectionsTitle-{{ section.id }}">
    <div class="akco-collections-layout">
      <div class="akco-collections-intro">
        <h2 id="AkcoCollectionsTitle-{{ section.id }}">{{ section.settings.heading | default: 'Featured Collections' | escape }}</h2>
        {% if section.settings.description != blank %}
          <p>{{ section.settings.description | escape }}</p>
        {% endif %}
        {% if section.settings.button_label != blank %}
          <a class="akco-collections-shop" href="{{ button_url | escape }}">{{ section.settings.button_label | escape }}</a>
        {% endif %}
      </div>
      {% if featured_products != blank %}
        <div class="akco-collections-rail" role="region" aria-labelledby="AkcoCollectionsTitle-{{ section.id }}" tabindex="0">
          <div class="akco-collections-cards">
            {% for featured_product in featured_products limit: 12 %}
              {% assign variant = featured_product.selected_or_first_available_variant %}
              <article class="akco-collections-card">
                <a class="akco-collections-product" href="{{ featured_product.url | escape }}" aria-label="View {{ featured_product.title | escape }} details">
                  {% if featured_product.featured_image != blank %}
                    {{ featured_product.featured_image | image_url: width: 1020 | image_tag: widths: '360, 540, 720, 1020', sizes: '(max-width: 488px) 82vw, (max-width: 760px) 400px, (max-width: 1000px) 40vw, 400px', loading: 'lazy', alt: '' }}
                  {% endif %}
                </a>
                <div class="akco-collections-details">
                  <span class="akco-collections-name">{{ featured_product.title | escape }}</span>
                  <div class="akco-collections-actions">
                    <span class="akco-collections-price">{{ variant.price | default: featured_product.price | money }}</span>
                    {% if featured_product.available == false %}
                      <button class="akco-collections-add" type="button" disabled>Sold out</button>
                    {% elsif featured_product.has_only_default_variant == false or featured_product.requires_selling_plan %}
                      <a class="akco-collections-add" href="{{ featured_product.url | escape }}" aria-label="Choose options for {{ featured_product.title | escape }}"><span class="akco-collections-bag-icon" aria-hidden="true"></span>Choose options</a>
                    {% else %}
                      <form class="akco-collections-cart-form" method="post" action="{{ routes.cart_add_url }}">
                        <input type="hidden" name="id" value="{{ variant.id }}">
                        <input type="hidden" name="quantity" value="1">
                        <button class="akco-collections-add" type="submit" aria-label="Add {{ featured_product.title | escape }} to cart"><span class="akco-collections-bag-icon" aria-hidden="true"></span>Add to cart</button>
                      </form>
                    {% endif %}
                  </div>
                </div>
                <button class="akco-collections-wishlist" type="button" data-collections-wishlist="{{ featured_product.id }}" aria-label="Wishlist for {{ featured_product.title | escape }}" aria-pressed="false" hidden>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.8c0 5.2-8.8 10-8.8 10s-8.8-4.8-8.8-10A4.8 4.8 0 0 1 12 6.4a4.8 4.8 0 0 1 8.8 2.4Z"/></svg>
                </button>
              </article>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <p class="akco-collections-empty">Select a collection or choose products to show here.</p>
      {% endif %}
    </div>
  </section>
{% endif %}

{% javascript %}
(() => {
  const selector = ".akco-featured-collections";
  const instances = new WeakMap();
  const wishlistKey = "akco-wishlist";
  const wishlist = new Set();
  try {
    const saved = JSON.parse(localStorage.getItem(wishlistKey));
    if (Array.isArray(saved)) saved.forEach((id) => wishlist.add(id));
  } catch {
    // The wishlist is still usable for this visit.
  }

  function initialize(section) {
    const rail = section.querySelector(".akco-collections-rail");
    if (!rail || instances.has(section)) return;
    const controller = new AbortController();
    const { signal } = controller;
    instances.set(section, controller);

    rail.addEventListener("scroll", () => {
      const blur = Math.min(Math.abs(rail.scrollLeft) / 50, 5);
      section.style.setProperty("--collections-blur", `${blur}px`);
    }, { passive: true, signal });

    for (const button of rail.querySelectorAll("[data-collections-wishlist]")) {
      button.setAttribute("aria-pressed", String(wishlist.has(button.dataset.collectionsWishlist)));
      button.hidden = false;
    }
    rail.addEventListener("click", (event) => {
      const button = event.target.closest("[data-collections-wishlist]");
      if (!button) return;
      const id = button.dataset.collectionsWishlist;
      if (wishlist.has(id)) wishlist.delete(id);
      else wishlist.add(id);
      const pressed = String(wishlist.has(id));
      for (const match of document.querySelectorAll("[data-collections-wishlist]")) {
        if (match.dataset.collectionsWishlist === id) match.setAttribute("aria-pressed", pressed);
      }
      try {
        localStorage.setItem(wishlistKey, JSON.stringify([...wishlist]));
      } catch {
        // Preserve the current selection when storage is unavailable.
      }
    }, { signal });
  }

  document.querySelectorAll(selector).forEach(initialize);
  document.addEventListener("shopify:section:load", (event) => {
    event.target.querySelectorAll(selector).forEach(initialize);
  });
  document.addEventListener("shopify:section:unload", (event) => {
    event.target.querySelectorAll(selector).forEach((section) => {
      instances.get(section)?.abort();
      instances.delete(section);
    });
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Featured Collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Collections" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Explore fragrances and attars from AK & Co." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop new arrivals" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "product_list", "id": "products", "label": "Featured products", "limit": 12, "info": "Use this list to choose the products and their order. It overrides the collection." }
  ],
  "presets": [{ "name": "Featured Collections" }]
}
{% endschema %}
