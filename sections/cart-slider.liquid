{% style %}
.akco-cart-slider {
  display: block;
  --serif: Georgia, serif;
  [hidden] { display: none !important; }
  *, *::before, *::after { box-sizing: border-box; }
  .cart-error { padding: 0 20px; color: #8f2121; }
  .cart-error:empty { display: none; }
  .cart-open { color: inherit; }
  .cart-drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(100%, 480px);
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #fbfaf7;
    color: #031206;
    box-shadow: -12px 0 48px rgb(3 18 6 / 16%);
  }

  .cart-drawer[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    animation: cart-slide-in .32s cubic-bezier(.22, 1, .36, 1) both;
  }

  .cart-drawer::backdrop {
    background: rgb(3 18 6 / 55%);
    animation: cart-backdrop-in .25s ease-out;
  }

  .cart-header,
  .cart-summary {
    padding: 20px clamp(16px, 5vw, 30px);
    background: #f1efe9;
  }

  .cart-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid #dedbd2;
  }

  .cart-brand {
    margin: 0;
    color: #79581f;
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .18em;
  }

  .cart-header h2 {
    margin: 6px 0 4px;
    font: 400 clamp(26px, 7vw, 36px)/1.15 var(--serif);
  }

  .cart-count {
    margin: 0;
    color: #55584d;
    font-size: .875rem;
  }

  .cart-drawer button {
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .cart-close {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid #d2cec3;
    border-radius: 50%;
    background: #fbfaf7;
  }

  .cart-close:hover { background: #e8e5dc; }

  .cart-body {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 clamp(16px, 5vw, 30px);
  }

  .cart-items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cart-item {
    display: grid;
    grid-template-columns: clamp(60px, 18vw, 80px) minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    padding-block: 20px;
    border-bottom: 1px solid #dedbd2;
  }

  .cart-item:last-child { border-bottom: 0; }

  .cart-item img {
    width: 100%;
    height: auto;
    aspect-ratio: 68 / 84;
    object-fit: contain;
    border-radius: 8px;
    background: #eeebe4;
  }

  .cart-item-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 10px;
  }

  .cart-item h3 {
    margin: 0;
    font: 400 1.125rem/1.3 var(--serif);
    overflow-wrap: anywhere;
  }

  .cart-variant {
    margin: 4px 0 8px;
    color: #55584d;
    font-size: .875rem;
  }

  .cart-item-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
  }

  .cart-stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid #d2cec3;
    border-radius: 8px;
    background: #fff;
  }

  .cart-stepper button {
    width: 36px;
    min-height: 38px;
    padding: 0;
    border: 0;
    border-radius: 7px;
    background: transparent;
  }

  .cart-stepper button:hover:not(:disabled) { background: #f1efe9; }

  .cart-stepper button:disabled {
    opacity: .5;
    cursor: default;
  }

  .cart-stepper span {
    min-width: 26px;
    text-align: center;
    font-size: .875rem;
    font-variant-numeric: tabular-nums;
  }

  .cart-item-controls button[data-cart-action="remove"] {
    min-height: 40px;
    padding: 0 2px;
    border: 0;
    background: transparent;
    color: #55584d;
    font-size: .875rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cart-line-price { font-size: .9375rem; font-variant-numeric: tabular-nums; }

  .cart-empty {
    padding: 44px 0;
    text-align: center;
  }

  .cart-empty h3 { margin: 0; font: 400 1.5rem/1.2 var(--serif); }
  .cart-empty p { margin: 8px 0 16px; color: #55584d; }

  .cart-empty a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cart-summary {
    border-top: 1px solid #dedbd2;
    padding-bottom: max(16px, env(safe-area-inset-bottom));
  }

  .cart-subtotal {
    display: flex;
    justify-content: space-between;
    margin: 0 0 12px;
  }

  .cart-subtotal output { font-weight: 700; font-variant-numeric: tabular-nums; }

  .cart-drawer .cart-checkout {
    width: 100%;
    min-height: 48px;
    border: 0;
    border-radius: 8px;
    background: #031206;
    color: white;
    font-weight: 600;
  }

  .cart-drawer .cart-checkout:hover { background: #24392b; }

  .cart-note {
    margin: 8px 0 0;
    color: #55584d;
    text-align: center;
    font-size: .8125rem;
  }

  .cart-drawer .cart-continue {
    display: block;
    min-height: 40px;
    margin: 2px auto 0;
    padding: 0 12px;
    border: 0;
    background: transparent;
    font-size: .875rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-drawer[open], .cart-drawer::backdrop { animation: none; }
  }
}
body:has(.akco-cart-slider .cart-drawer[open]) { overflow: hidden; }
@keyframes cart-slide-in {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}
@keyframes cart-backdrop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
{% endstyle %}

<akco-cart-slider class="akco-cart-slider" data-section-id="{{ section.id }}" data-change-url="{{ routes.cart_change_url }}.js">
  <a class="cart-open" href="{{ routes.cart_url }}" data-cart-slider-open aria-haspopup="dialog" aria-controls="AkcoCart-{{ section.id }}">
    {{ section.settings.button_label | escape }}
  </a>
  <dialog class="cart-drawer" id="AkcoCart-{{ section.id }}" aria-labelledby="AkcoCartTitle-{{ section.id }}">
    <header class="cart-header">
      <div>
        <p class="cart-brand">{{ shop.name | escape }}</p>
        <h2 id="AkcoCartTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        <p class="cart-count" aria-live="polite" data-cart-count>{{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}</p>
      </div>
      <button type="button" class="cart-close" data-cart-close aria-label="Close shopping bag" autofocus>✕</button>
    </header>
    <div class="cart-body">
      <p class="cart-error" role="alert"></p>
      <div data-cart-items>
        {% if cart.empty? %}
          <div class="cart-empty">
            <h3>Your bag is empty</h3>
            <a href="{{ routes.all_products_collection_url }}">Browse products</a>
          </div>
        {% else %}
          <ul class="cart-items" aria-label="Items in your bag">
            {% for item in cart.items %}
              <li class="cart-item" data-line-key="{{ item.key | escape }}">
                {% if item.image %}
                  {{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                {% else %}
                  <span></span>
                {% endif %}
                <div>
                  <div class="cart-item-heading">
                    <h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3>
                    <strong class="cart-line-price">{{ item.final_line_price | money }}</strong>
                  </div>
                  {% unless item.product.has_only_default_variant %}
                    <p class="cart-variant">{{ item.variant.title | escape }}</p>
                  {% endunless %}
                  {% if item.selling_plan_allocation %}
                    <p class="cart-variant">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
                  {% endif %}
                  {% for property in item.properties %}
                    {% assign first_character = property.first | slice: 0 %}
                    {% if property.last != blank and first_character != '_' %}
                      <p class="cart-variant">{{ property.first | escape }}: {{ property.last | escape }}</p>
                    {% endif %}
                  {% endfor %}
                  <div class="cart-item-controls">
                    <div class="cart-stepper">
                      <button type="button" data-cart-action="decrease" data-quantity="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity of {{ item.title | escape }}" {% if item.quantity <= 1 %}disabled{% endif %}>−</button>
                      <span>{{ item.quantity }}</span>
                      <button type="button" data-cart-action="increase" data-quantity="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity of {{ item.title | escape }}">+</button>
                    </div>
                    <button type="button" data-cart-action="remove" data-quantity="0" aria-label="Remove {{ item.title | escape }}">Remove</button>
                  </div>
                </div>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
    <footer class="cart-summary" data-cart-summary {% if cart.empty? %}hidden{% endif %}>
      <p class="cart-subtotal"><strong>Subtotal</strong><output aria-live="polite">{{ cart.total_price | money }}</output></p>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" class="cart-checkout" name="checkout">Checkout</button>
      </form>
      <button type="button" class="cart-continue" data-cart-close>Continue shopping</button>
    </footer>
  </dialog>
</akco-cart-slider>

{% javascript %}
if (!customElements.get('akco-cart-slider')) {
  customElements.define('akco-cart-slider', class extends HTMLElement {
    connectedCallback() {
      this.controller = new AbortController();
      const { signal } = this.controller;
      const drawer = this.querySelector('dialog');
      const body = drawer.querySelector('.cart-body');
      const error = drawer.querySelector('.cart-error');
      const sectionId = this.dataset.sectionId;
      const sectionUrl = new URL(location.href);
      sectionUrl.searchParams.set('section_id', sectionId);

      const updateDrawer = (html) => {
        const replacement = new DOMParser().parseFromString(html, 'text/html');
        const selectors = ['[data-cart-count]', '[data-cart-items]', '[data-cart-summary]'];
        const fragments = selectors.map((selector) => replacement.querySelector(selector));
        if (fragments.some((fragment) => !fragment)) throw new Error('The shopping bag could not refresh.');
        const scrollTop = body.scrollTop;
        selectors.forEach((selector, index) => drawer.querySelector(selector).replaceWith(fragments[index]));
        body.scrollTop = scrollTop;
      };

      const refresh = async () => {
        const response = await fetch(sectionUrl, { signal, cache: 'no-store' });
        if (!response.ok) throw new Error('The shopping bag could not refresh.');
        updateDrawer(await response.text());
      };

      document.addEventListener('click', async (event) => {
        const opener = event.target.closest('[data-cart-slider-open]');
        if (!opener || event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (drawer.open) return;
        event.preventDefault();
        error.textContent = '';
        drawer.showModal();
        if (this.busy) return;
        this.busy = true;
        try {
          await refresh();
        } catch (failure) {
          if (!signal.aborted) error.textContent = failure.message;
        } finally {
          this.busy = false;
        }
      }, { signal });

      drawer.addEventListener('click', async (event) => {
        if (event.target === drawer || event.target.closest('[data-cart-close]')) {
          drawer.close();
          return;
        }
        const control = event.target.closest('[data-cart-action]');
        if (!control || this.busy) return;
        const { lineKey } = control.closest('[data-line-key]').dataset;
        this.busy = true;
        error.textContent = '';
        drawer.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch(this.dataset.changeUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              id: lineKey,
              quantity: Number(control.dataset.quantity),
              sections: [sectionId],
              sections_url: location.pathname + location.search
            }),
            signal
          });
          const result = await response.json();
          if (!response.ok || result.errors) {
            await refresh();
            throw new Error(typeof result.description === 'string' ? result.description : 'Could not update the shopping bag.');
          }
          const html = result.sections?.[sectionId];
          if (html) updateDrawer(html);
          else await refresh();
          if (drawer.open) {
            const row = Array.from(drawer.querySelectorAll('[data-line-key]')).find((item) => item.dataset.lineKey === lineKey);
            const next = row?.querySelector('[data-cart-action="' + control.dataset.cartAction + '"]:enabled');
            (next || drawer.querySelector('.cart-close')).focus();
          }
        } catch (failure) {
          if (!signal.aborted) error.textContent = failure.message;
        } finally {
          this.busy = false;
          drawer.removeAttribute('aria-busy');
        }
      }, { signal });
    }

    disconnectedCallback() {
      this.controller?.abort();
    }
  });
}
{% endjavascript %}

{% schema %}
{
  "name": "Cart slider",
  "limit": 1,
  "settings": [
    { "type": "text", "id": "button_label", "label": "Open button label", "default": "Shopping bag" },
    { "type": "text", "id": "heading", "label": "Drawer heading", "default": "Your shopping bag" }
  ],
  "presets": [{ "name": "Cart slider" }]
}
{% endschema %}
